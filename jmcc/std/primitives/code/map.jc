/// RU: Псевдоним ассоциативного массива (словаря).
/// EN: Alias for dictionary / map.
@alias("словарь")
export typealias dict = map;

/// RU: Псевдоним обобщенного ассоциативного массива map<K, V>.
/// EN: Alias for generic map<K, V>.
@alias("словарь")
export typealias dict<K, V> = map<K, V>;

/// RU: Ассоциативный массив (словарь) ключ-значение.
/// EN: Associative array (key-value map).
@alias("карта")
@alias("словарь")
@lang_item
export class map<K, V> implements Iterable<K> {
    /// RU:
    /// Возвращает итератор по ключам карты.
    /// EN:
    /// Returns an iterator over the keys of the map.
    @alias("итератор")
    @alias("into_iter")
    function iter(self: map<K, V>) -> MapKeyIterator<K, V> {
        return MapKeyIterator(self);
    }

    inline function __equals__(first: map<K, V>, second: map<K, V>) -> boolean {
        return first.equals(second);
    }

    inline function __not_equals__(first: map<K, V>, second: map<K, V>) -> boolean {
        return first.not_equals(second);
    }

    @alias("contains", "содержит")
    inline function __contains__(first: map<K, V>, second: K) -> boolean {
        return first.map_has_key(second);
    }

    inline function __add__(first: map<K, V>, second: map<K, V>) -> map<K, V> {
        return variable::append_map(first, second);
    }

    @getter
    inline function __subscript__(self: map<K, V>, index: K) -> V {
        return self.get_map_value(index);
    }

    @setter
    inline function __subscript__(self: map<K, V>, index: K, value: V) -> map<K, V> {
        self.set_map_value(index, value);
        return self;
    }

    /// RU:
    /// Возвращает массив всех ключей карты.
    /// EN:
    /// Returns an array of all keys in the map.
    @alias("ключи")
    inline function keys(self: map<K, V>) -> array<K> {
        return variable::get_map_keys(self);
    }

    /// RU:
    /// Возвращает массив всех значений карты.
    /// EN:
    /// Returns an array of all values in the map.
    @alias("значения")
    inline function values(self: map<K, V>) -> array<V> {
        return variable::get_map_values(self);
    }

    /// RU:
    /// Проверяет наличие ключа в карте.
    /// EN:
    /// Checks if the map contains the specified key.
    @alias("содержит_ключ")
    @alias("есть_ключ")
    inline function has_key(self: map<K, V>, key: K) -> boolean {
        return self.map_has_key(key);
    }

    /// RU:
    /// Удаляет запись из карты по ключу.
    /// EN:
    /// Removes an entry from the map by key.
    @alias("удалить")
    inline function remove(self: map<K, V>, key: K) -> map<K, V> {
        var removed: V;
        variable::remove_map_entry(removed, self, self, key, []);
        return self;
    }

    /// RU:
    /// Очищает все записи карты.
    /// EN:
    /// Clears all entries from the map.
    @alias("очистить")
    inline function clear(self: map<K, V>) -> map<K, V> {
        variable::clear_map(self);
        return self;
    }

    /// RU:
    /// Возвращает значение по ключу, либо значение по умолчанию.
    /// EN:
    /// Returns the value for key, or the default value if key is not found.
    @alias("получить")
    inline function get(self: map<K, V>, key: K, default_value: V) -> V {
        return variable::get_map_value(self, key, default_value);
    }

    /// RU:
    /// Сортирует карту по ключам или значениям в указанном порядке.
    /// EN:
    /// Sorts the map by keys or values in the specified order.
    @alias("сортировать")
    inline function sort(
        self: map<K, V>,
        order: text = "ASCENDING",
        by: text = "KEYS",
    ) -> map<K, V> {
        return variable::sort_map(self, sort_order = order, sort_type = by);
    }

    /// RU:
    /// Возвращает количество записей в карте.
    /// EN:
    /// Returns the number of entries in the map.
    @alias("длина")
    @alias("размер")
    inline function len(self: map<K, V>) -> number {
        return variable::get_map_size(self);
    }
}
