перечисление Статус {
    АКТИВЕН,
    ОТКЛЮЧЕН
}

класс Пользователь {
    переменная имя: текст;
    переменная возраст: число;

    функция __конструктор__(сам: Пользователь, имя: текст, возраст: число) -> Пользователь {
        сам.имя = имя;
        сам.возраст = возраст;
        вернуть сам;
    }

    функция получить_имя(сам: Пользователь) -> текст {
        вернуть сам.имя;
    }
}

класс Координата {
    перем х: число;
    перем у: число;

    функция __иниц__(сам: Координата, х: число, у: число) -> Координата {
        сам.х = х;
        сам.у = у;
        вернуть сам;
    }

    функция __сложить__(первая: Координата, вторая: Координата) -> Координата {
        вернуть Координата(первая.х + вторая.х, первая.у + вторая.у);
    }
}

@alias("greet")
функция приветствовать(имя: text) -> text {
    вернуть "Привет, $имя!";
}

событие<player_join> {
    перем юзер = Пользователь("Алексей", 25);
    пусть имя = юзер.получить_имя();
    переменная статус = Статус.АКТИВЕН;
    пусть м1 = приветствовать(имя);
    перем м2 = greet(имя);
    пусть к1 = Координата(1, 2);
    пусть к2 = Координата(3, 4);
    пусть к3 = к1 + к2;
}
